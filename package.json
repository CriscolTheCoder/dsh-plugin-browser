{
  "name": "dsh-plugin-browser",
  "description": "Plugin market entry point + installed-plugin dashboard for DSH — browse the awesome-dsh-plugin catalog with live installed/loaded state, one-click install/update/uninstall through dshmarket, plus a `list_plugins` / `browse_plugin_market` agent tool. · DSH 插件市场入口 + 已装插件面板：浏览 awesome 插件目录（实时已装/加载状态），经 dshmarket 一键安装/更新/卸载，附 list_plugins / browse_plugin_market 两个 agent 工具。",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CriscolTheCoder/dsh-plugin-browser.git"
  },
  "homepage": "https://github.com/CriscolTheCoder/dsh-plugin-browser",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-inventory",
    "plugin-browser",
    "plugin-market",
    "marketplace"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "data",
    "cordis.patch.yml"
  ]
}
